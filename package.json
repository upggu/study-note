{
  "name": "study-note",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check:content": "node --test scripts/deck-sidebar.test.mjs && node scripts/check-content.mjs",
