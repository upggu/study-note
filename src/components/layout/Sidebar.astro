---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import TopicsDropdown from 'starlight-sidebar-topics-dropdown/TopicsDropdown.astro';
import { getDeckUpdatedAt } from '../../data/deck-updated-at';
import { stripBase } from '../../utils/site-path.mjs';

// 덱(topic) 목록을 사이드바 맨 위 드롭다운 하나로 접는다.
// starlight-sidebar-topics의 기본 Sidebar override는 덱을 전부 세로로 나열해서,
// 덱이 늘어날수록 정작 현재 덱의 목차가 화면 밖으로 밀렸다.
// 여기서 갈아끼우면 플러그인 쪽 override는 무시된다 —
// 플러그인이 자기 components 뒤에 사용자 components를 스프레드하기 때문이다.
//
// 가드는 플러그인 원본과 같다: 사이드바가 없거나(랜딩) topic 밖 페이지면
// currentTopic이 undefined라 드롭다운이 렌더될 수 없다.
const { hasSidebar } = Astro.locals.starlightRoute;
const { isPageWithTopic } = Astro.locals.starlightSidebarTopics;

if (hasSidebar && isPageWithTopic) {
	const updatedAt = await getDeckUpdatedAt();
	const timestamp = (link: string) => updatedAt.get((stripBase(link, import.meta.env.BASE_URL) ?? '').split('/').filter(Boolean)[0])?.getTime() ?? 0;
	// 드롭다운이 읽는 요청별 목록을 최근 수정일 내림차순으로 정렬한다.
	// 이력이 없으면 마지막, 동률이면 loader의 navOrder 순서를 유지한다.
	Astro.locals.starlightSidebarTopics.topics = [...Astro.locals.starlightSidebarTopics.topics]
		.sort((a, b) => timestamp(b.link) - timestamp(a.link));
}
---

{hasSidebar && isPageWithTopic && <TopicsDropdown />}
<Default><slot /></Default>
