---
// 덱 페이지의 헤더 자동 숨김 — 맨 위에서 벗어나면 헤더가 위로 사라지고, 마우스를 헤더가 있던
// 자리로 가져가면 나타났다가 치우면 다시 숨는다. 모니터에서 본문을 읽는 동안 사이트 제목·덱 이름이
// 시야에 남지 않게 하려는 것이다 (macOS 메뉴 막대 자동 숨김, 전체 화면 플레이어 컨트롤과 같은 관례).
//
// 상태는 <html data-header-hidden>으로 표현하고, 실제로 헤더·사이드바·페이지 목차를 밀어 올리는
// 규칙은 src/styles/custom.css에 있다 (Starlight의 header/.sidebar-pane/.right-sidebar 같은
// 전역 요소를 건드리므로 컴포넌트 스코프로는 닿지 않는다).
//
// SiteTitle override가 덱(topic) 페이지에서만 이 컴포넌트를 렌더한다. 랜딩은 헤더 바로 아래에
// fixed 필터 요약을 띄우므로 대상이 아니다.
//
// 보이는 조건 (하나라도 맞으면 보인다):
// - 스크롤이 헤더 높이 안쪽, 즉 맨 위 근처다.
// - 마우스 포인터가 헤더 높이 안쪽에 있다. 스크롤하면 이 상태를 지우고, 포인터가 실제로 움직여야
//   다시 센다 — 브라우저가 스크롤 뒤 같은 좌표로 보내는 합성 이벤트 때문에 깜빡이지 않게 하려는 것이다.
//   터치는 제외한다 — 화면 위쪽에서 시작하는 스크롤 제스처가 헤더를 띄우기 때문이다.
// - 마우스가 없는 기기(hover: none)에서 위로 스크롤하는 중이다. 터치 기기는 포인터로 꺼낼 수 없으니
//   흔한 "올리면 나타남" 동작을 남긴다. 8px 미만의 흔들림은 방향 판정에서 무시한다.
// - 헤더 안 요소에 키보드 초점(:focus-visible)이 있다 (Tab 이동, 검색 dialog를 닫고 돌아올 때).
//   마우스 클릭으로 남은 초점은 세지 않는다 — 테마 버튼을 누른 뒤 포인터를 치우면 숨어야 한다.
// - 좁은 화면의 사이드바 popover나 dialog(검색·D2 확대)가 열려 있다.
// 숨길 때만 짧게 지연해 경계에서 포인터가 오가도 떨리지 않게 한다.
---

<header-autohide hidden></header-autohide>

<script>
	class HeaderAutoHide extends HTMLElement {
		connectedCallback() {
			const header = this.closest('header');
			if (!header) return;

			const root = document.documentElement;
			const ATTR = 'data-header-hidden';
			const TOLERANCE = 8;
			const HIDE_DELAY = 200;
			const hoverCapable = matchMedia('(hover: hover)');
			const navHeight = () => header.offsetHeight;

			let pointerInZone = false;
			let scrollingUp = false;
			let hideTimer = 0;

			const overlayOpen = () => {
				try {
					return document.querySelector(':popover-open, dialog[open]') !== null;
				} catch {
					return false;
				}
			};
			const keyboardFocusInHeader = () => {
				try {
					return header.querySelector(':focus-visible') !== null;
				} catch {
					return header.matches(':focus-within');
				}
			};
			const shouldShow = () =>
				window.scrollY <= navHeight() ||
				pointerInZone ||
				(scrollingUp && !hoverCapable.matches) ||
				keyboardFocusInHeader() ||
				overlayOpen();

			const apply = () => {
				if (shouldShow()) {
					clearTimeout(hideTimer);
					hideTimer = 0;
					root.removeAttribute(ATTR);
				} else if (!hideTimer) {
					hideTimer = window.setTimeout(() => {
						hideTimer = 0;
						if (!shouldShow()) root.setAttribute(ATTR, '');
					}, HIDE_DELAY);
				}
			};

			let lastY = window.scrollY;
			let ticking = false;
			window.addEventListener(
				'scroll',
				() => {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						ticking = false;
						const y = window.scrollY;
						const delta = y - lastY;
						if (Math.abs(delta) >= TOLERANCE) {
							lastY = y;
							scrollingUp = delta < 0;
						}
						pointerInZone = false;
						apply();
					});
				},
				{ passive: true }
			);

			let lastX = NaN;
			let lastPointerY = NaN;
			document.addEventListener(
				'pointermove',
				(event) => {
					if (event.pointerType !== 'mouse') return;
					const moved = event.clientX !== lastX || event.clientY !== lastPointerY;
					lastX = event.clientX;
					lastPointerY = event.clientY;
					if (!moved) return;
					pointerInZone = event.clientY <= navHeight();
					apply();
				},
				{ passive: true }
			);

			header.addEventListener('focusin', apply);
			// focusout 시점에는 초점이 아직 옮겨지기 전일 수 있어 다음 틱에 다시 판정한다.
			header.addEventListener('focusout', () => setTimeout(apply, 0));
			document.addEventListener('toggle', apply, true);
			document.addEventListener('close', apply, true);
		}
	}

	customElements.define('header-autohide', HeaderAutoHide);
</script>
