---
import { withBase } from '../../utils/site-path.mjs';
/**
 * 외부 문서를 새 창에서 안전하게 여는 인라인 링크.
 *
 * Usage:
 *   <ExternalLink href="https://example.com/docs">공식 문서</ExternalLink>
 */
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a href={withBase(href, import.meta.env.BASE_URL)} target="_blank" rel="noopener noreferrer"><slot /></a>
